{
  "name": "app",
  "version": "1.0.0",
  "description": "Chrome extension that monitors img tags on the page and replaces their images with ones that show the dimensions of the originals.",
  "main": "service_worker.js",
  "scripts": {
    "test": "playwright test spec/core.spec.js",
    "preview": "npx -y serve . -l 3000",
    "format": "prettier --write '**/*.{js,html,json,css}'",
    "build": "zip -r extension.zip . -x 'screenshots/*' -x '*.git*' -x 'node_modules/*' -x 'spec/*' -x 'package*.json' -x 'playwright-report/*' -x 'test-results/*' -x '*.DS_Store' -x '.gitignore'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bliof/800x600.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bliof/800x600/issues"
  },
  "homepage": "https://github.com/bliof/800x600#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "prettier": "^3.4.2"
  }
}
